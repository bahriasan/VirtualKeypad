			(USB_OTG_GINTMSK_MMISM == (USB_OTG_FS->GINTMSK & USB_OTG_GINTMSK_MMISM_Msk)))
	{
		//MMIS ISR
		USB_OTG_FS->GINTSTS |= USB_OTG_GINTSTS_MMIS;	////Clean the Status(c_w1)
	}
	if((USB_OTG_GINTSTS_OTGINT == (USB_OTG_FS->GINTSTS & USB_OTG_GINTSTS_OTGINT_Msk)) &&
