  51:../src/main.c **** // ----------------------------------------------------------------------------
  52:../src/main.c **** //
  53:../src/main.c **** // Print a greeting message on the trace device and enter a loop
  54:../src/main.c **** // to count seconds.
  55:../src/main.c **** //
  56:../src/main.c **** // Trace support is enabled by adding the TRACE macro definition.
  57:../src/main.c **** // By default the trace messages are forwarded to the DEBUG output,
  58:../src/main.c **** // but can be rerouted to any device or completely suppressed, by
  59:../src/main.c **** // changing the definitions required in system/src/diag/trace-impl.c
  60:../src/main.c **** // (currently OS_USE_TRACE_ITM, OS_USE_TRACE_SEMIHOSTING_DEBUG/_STDOUT).
  61:../src/main.c **** //
  62:../src/main.c **** // ----------------------------------------------------------------------------
