  56:../src/main.c **** //
  57:../src/main.c **** // Print a greeting message on the trace device and enter a loop
  58:../src/main.c **** // to count seconds.
  59:../src/main.c **** //
  60:../src/main.c **** // Trace support is enabled by adding the TRACE macro definition.
  61:../src/main.c **** // By default the trace messages are forwarded to the DEBUG output,
  62:../src/main.c **** // but can be rerouted to any device or completely suppressed, by
  63:../src/main.c **** // changing the definitions required in system/src/diag/trace-impl.c
  64:../src/main.c **** // (currently OS_USE_TRACE_ITM, OS_USE_TRACE_SEMIHOSTING_DEBUG/_STDOUT).
  65:../src/main.c **** //
