   3:../src/usbd_hid.c **** /*
   4:../src/usbd_hid.c ****  * When a Get_Descriptor(Configuration) request is issued, it returns the Configuration descriptor
   5:../src/usbd_hid.c ****  * That is, the order shall be:
   6:../src/usbd_hid.c ****  * Configuration descriptor
   7:../src/usbd_hid.c ****  * Interface descriptor (specifying HID Class)
   8:../src/usbd_hid.c ****  * HID descriptor (associated with above Interface)
   9:../src/usbd_hid.c ****  * Endpoint descriptor (for HID Interrupt In Endpoint)
  10:../src/usbd_hid.c ****  * Optional Endpoint descriptor (for HID Interrupt Out Endpoint)
  11:../src/usbd_hid.c ****  */
  12:../src/usbd_hid.c **** 
  13:../src/usbd_hid.c **** uint8 FSReportDescriptor[63] =
  14:../src/usbd_hid.c **** {
  15:../src/usbd_hid.c **** 		0x05, 0x01,	//Usage Page (Generic Desktop),
  16:../src/usbd_hid.c **** 		0x09, 0x06,	//Usage (Keyboard),
  17:../src/usbd_hid.c **** 		0xA1, 0x01,	//Collection (Application),
  18:../src/usbd_hid.c **** 		0x05, 0x07,	//Usage Page (Key Codes);
  19:../src/usbd_hid.c **** 		0x19, 0xE0,	//Usage Minimum (224),
  20:../src/usbd_hid.c **** 		0x29, 0xE7,	//Usage Maximum (231),
  21:../src/usbd_hid.c **** 		0x15, 0x00,	//Logical Minimum (0),
  22:../src/usbd_hid.c **** 		0x25, 0x01,	//Logical Maximum (1),
  23:../src/usbd_hid.c **** 		0x75, 0x01,	//Report Size (1),
  24:../src/usbd_hid.c **** 		0x95, 0x08,	//Report Count (8),
  25:../src/usbd_hid.c **** 		0x81, 0x02,	//Input (Data, Variable, Absolute), ;Modifier byte
  26:../src/usbd_hid.c **** 		0x95, 0x01,	//Report Count (1),
  27:../src/usbd_hid.c **** 		0x75, 0x08,	//Report Size (8),
  28:../src/usbd_hid.c **** 		0x81, 0x01,	//Input (Constant), ;Reserved byte
  29:../src/usbd_hid.c **** 		0x95, 0x05,	//Report Count (5),
  30:../src/usbd_hid.c **** 		0x75, 0x01,	//Report Size (1),
  31:../src/usbd_hid.c **** 		0x05, 0x08,	//Usage Page (Page# for LEDs),
  32:../src/usbd_hid.c **** 		0x19, 0x01,	//Usage Minimum (1),
  33:../src/usbd_hid.c **** 		0x29, 0x05,	//Usage Maximum (5),
  34:../src/usbd_hid.c **** 		0x91, 0x02,	//Output (Data, Variable, Absolute), ;LED report
  35:../src/usbd_hid.c **** 		0x95, 0x01,	//Report Count (1),
  36:../src/usbd_hid.c **** 		0x75, 0x03,	//Report Size (3),
  37:../src/usbd_hid.c **** 		0x91, 0x01,	//Output (Constant), ;LED report padding
  38:../src/usbd_hid.c **** 		0x95, 0x06,	//Report Count (6),
  39:../src/usbd_hid.c **** 		0x75, 0x08,	//Report Size (8),
  40:../src/usbd_hid.c **** 		0x15, 0x00,	//Logical Minimum (0),
  41:../src/usbd_hid.c **** 		0x25, 0x65,	//Logical Maximum(101),
  42:../src/usbd_hid.c **** 		0x05, 0x07,	//Usage Page (Key Codes),
  43:../src/usbd_hid.c **** 		0x19, 0x00,	//Usage Minimum (0),
  44:../src/usbd_hid.c **** 		0x29, 0x65,	//Usage Maximum (101),
  45:../src/usbd_hid.c **** 		0x81, 0x00,	//Input (Data, Array), ;Key arrays (6 bytes)
  46:../src/usbd_hid.c **** 		0xC0		//End Collection
  47:../src/usbd_hid.c **** };
