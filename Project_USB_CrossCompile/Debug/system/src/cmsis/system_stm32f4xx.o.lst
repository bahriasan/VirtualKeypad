 171:../system/src/cmsis/system_stm32f4xx.c ****     SCB->CPACR |= ((3UL << 10*2)|(3UL << 11*2));  /* set CP10 and CP11 Full Access */
 172:../system/src/cmsis/system_stm32f4xx.c ****   #endif
 173:../system/src/cmsis/system_stm32f4xx.c **** 
