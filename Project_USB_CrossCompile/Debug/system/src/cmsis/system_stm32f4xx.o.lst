 129:../system/src/cmsis/system_stm32f4xx.c ****   /* This variable is updated in three ways:
 130:../system/src/cmsis/system_stm32f4xx.c ****       1) by calling CMSIS function SystemCoreClockUpdate()
 131:../system/src/cmsis/system_stm32f4xx.c ****       2) by calling HAL API function HAL_RCC_GetHCLKFreq()
 132:../system/src/cmsis/system_stm32f4xx.c ****       3) each time HAL_RCC_ClockConfig() is called to configure the system clock frequency 
 133:../system/src/cmsis/system_stm32f4xx.c ****          Note: If you use this function to configure the system clock; then there
 134:../system/src/cmsis/system_stm32f4xx.c ****                is no need to call the 2 first functions listed above, since SystemCoreClock
 135:../system/src/cmsis/system_stm32f4xx.c ****                variable is updated automatically.
 136:../system/src/cmsis/system_stm32f4xx.c ****   */
 137:../system/src/cmsis/system_stm32f4xx.c **** uint32_t SystemCoreClock = 16000000;
 138:../system/src/cmsis/system_stm32f4xx.c **** const uint8_t AHBPrescTable[16] = {0, 0, 0, 0, 0, 0, 0, 0, 1, 2, 3, 4, 6, 7, 8, 9};
 139:../system/src/cmsis/system_stm32f4xx.c **** const uint8_t APBPrescTable[8]  = {0, 0, 0, 0, 1, 2, 3, 4};
 140:../system/src/cmsis/system_stm32f4xx.c **** /**
 141:../system/src/cmsis/system_stm32f4xx.c ****   * @}
 142:../system/src/cmsis/system_stm32f4xx.c ****   */
